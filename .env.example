# Database Configuration
DB_HOST=localhost
DB_NAME=certificate_system
DB_USER=root
DB_PASS=

# Security
SUPER_ADMIN_PASSCODE=1234

# Public base URL of this install, with no trailing slash.
# Used to build links sent by email, including admin password reset links.
# Leave blank only for local development: without it the URL is derived from
# the request's Host header, which a client can forge.
PORTAL_BASE_URL="https://certificates.example.org"

# SMTP Configuration (For Automated Emails)
SMTP_HOST=smtp.hostinger.com
SMTP_AUTH=true
SMTP_USER=noreply@dcwwiki.org
SMTP_PASS=
SMTP_SECURE=tls
SMTP_PORT=587

# Dynamic Thumbnails (PDF to Image conversion for LinkedIn/Socials)
DYNAMIC_THUMBNAILS_ENABLED=true

# White-Label Organization Links (See WHITE_LABELING.md for details)
ORG_NAME="Deoband Community Wikimedia"
ORG_URL_HOME="https://dcwwiki.org/"
ORG_URL_ABOUT="https://dcwwiki.org/About"
ORG_URL_PROGRAMS="https://dcwwiki.org/Programs"
ORG_URL_PARTNERSHIPS="https://dcwwiki.org/Partnerships"
ORG_URL_NEWS="https://dcwwiki.org/News"
ORG_URL_VISION="https://dcwwiki.org/Vision_%26_Objectives"

ORG_URL_SUBSCRIBE="https://dcwwiki.org/Subscribe"
ORG_URL_MEMBERSHIP="https://dcwwiki.org/Membership"
ORG_URL_POLICY="https://dcwwiki.org/Friendly_space_policy"
ORG_URL_CONTACT="https://dcwwiki.org/Contact"
ORG_EMAIL_MODERATOR="moderator@dcwwiki.org"

ORG_URL_MASTODON="https://wikis.world/@dcwwiki"
ORG_URL_FACEBOOK="https://www.facebook.com/dcwwiki"
ORG_URL_INSTAGRAM="https://www.instagram.com/dcwwiki/"
ORG_URL_LINKEDIN="https://www.linkedin.com/company/deoband-community-wikimedia"
ORG_URL_TWITTER="https://twitter.com/dcwwiki"
ORG_URL_YOUTUBE="https://www.youtube.com/@dcwwiki"
